{
  "name": "mac-space-sweeper",
  "version": "0.1.0",
  "description": "Interactive macOS disk cleanup tool with a Python scanner and an Ink/Pastel terminal UI.",
  "type": "module",
  "bin": {
    "mac-space-sweeper": "build/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/cli.js",
    "check": "npm run build && python3 -m py_compile scripts/mac_junk_cleaner.py"
  },
  "engines": {
    "node": ">=16.13"
  },
  "keywords": [
    "macos",
    "cleanup",
    "disk-usage",
    "ink",
    "pastel",
    "python",
    "terminal-ui"
  ],
  "dependencies": {
    "ink": "4.4.1",
    "pastel": "2.0.2",
    "react": "18.2.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "18.19.39",
    "@types/react": "18.2.79",
    "typescript": "5.5.4"
  }
}
